{
  "model": {
    "vocab_size": 10000,
    "context_length": 128,
    "d_model": 256,
    "num_layers": 2,
    "num_heads": 8,
    "d_ff": 672,
    "rope_theta": 10000.0
  },
  "optimizer": {
    "lr": 0.0003,
    "min_lr": 0.00001,
    "warmup_iters": 200,
    "cosine_iters": 5000,
    "weight_decay": 0.01,
    "clip_grad_norm": 1.0
  },
  "train": {
    "batch_size": 64,
    "train_steps": 5000,
    "val_interval": 100,
    "val_batches": 10,
    "save_interval": 1000,
    "log_interval": 1,
    "save_path": "./checkpoints/small_fast/",
    "resume_checkpoint": null
  }
}
