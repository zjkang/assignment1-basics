{
  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "d_model": 768,
    "num_layers": 6,
    "num_heads": 16,
    "d_ff": 2048,
    "rope_theta": 10000.0
  },
  "optimizer": {
    "lr": 0.0001,
    "min_lr": 0.00001,
    "warmup_iters": 1000,
    "cosine_iters": 10000,
    "weight_decay": 0.01,
    "clip_grad_norm": 1.0
  },
  "train": {
    "batch_size": 24,
    "train_steps": 5000,
    "val_interval": 100,
    "val_batches": 10,
    "save_interval": 1000,
    "log_interval": 1,
    "save_path": "./checkpoints/large_model/",
    "resume_checkpoint": null
  }
}
